# Offline test run -- no Firebase project, no billing, no credentials.
# Emulators ignore these values; only the demo- projectId prefix matters.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-janshakti.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-janshakti
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-janshakti.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_RENDER_URL=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-janshakti
